# ==============================================================================
# ATELIER VÉRITÉ — ROOT QA ENVIRONMENT TEMPLATE (.env.qa.example)
# Copy to .env.qa for isolated QA testing. Never commit real QA passwords.
# ==============================================================================

APP_ENV=qa
NODE_ENV=test

# Backend QA
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5002
BACKEND_INTERNAL_PORT=5002
PORT=5002
BASE_URL=http://127.0.0.1:5002
BACKEND_URL=http://127.0.0.1:5002

# Frontend QA
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5174
FRONTEND_INTERNAL_PORT=80
FRONTEND_PREVIEW_PORT=4174
FRONTEND_URL=http://127.0.0.1:5174
CLIENT_URL=http://127.0.0.1:5174
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Vite Client QA
VITE_APP_ENV=qa
VITE_HOST=127.0.0.1
VITE_PORT=5174
VITE_PREVIEW_PORT=4174
VITE_STRICT_PORT=true
VITE_API_URL=http://127.0.0.1:5002/api
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:5002
VITE_WS_URL=http://127.0.0.1:5002

# QA MongoDB & Replica Set
MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_INTERNAL_PORT=27017
MONGO_DATABASE=atelier_verite_qa
MONGO_CONNECTIONSTRING=mongodb://127.0.0.1:27018/atelier_verite_qa
MONGO_RS_HOST=127.0.0.1
MONGO_RS_PORT=27019
MONGO_RS_INTERNAL_PORT=27019
MONGO_RS_NAME=rs0
MONGO_RS_DATABASE=atelier_verite_qa_rs
MONGO_RS_CONNECTIONSTRING=mongodb://127.0.0.1:27019/atelier_verite_qa_rs?replicaSet=rs0
QA_RS_MONGO_URI=mongodb://127.0.0.1:27019/atelier_verite_qa_rs?replicaSet=rs0

# QA Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_INTERNAL_PORT=6379
REDIS_URL=redis://127.0.0.1:6381

# Playwright & E2E
QA_E2E_ENABLED=true
QA_API_URL=http://127.0.0.1:5002/api
QA_FRONTEND_URL=http://127.0.0.1:5174
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5174
PLAYWRIGHT_PORT=5174
PLAYWRIGHT_CI_HOST=127.0.0.1
PLAYWRIGHT_CI_PORT=4179
QA_SEED_PASSWORD=replace_with_a_disposable_qa_password
