# ==============================================================================
# ATELIER VÉRITÉ — Monorepo Root Environment Configuration Template (.env.example)
#
# HƯỚNG DẪN:
# 1. Sao chép tệp này thành .env ở thư mục gốc trước khi chạy ứng dụng cục bộ:
#    cp .env.example .env
# 2. KHÔNG BAO GIỜ commit tệp .env thật chứa thông tin xác thực lên Git.
# 3. Tất cả các giá trị dưới đây là PLACEHOLDER AN TOÀN cho môi trường phát triển cục bộ.
# ==============================================================================

# ── [FRONTEND] VITE RUNTIME CONFIGURATION ──────────────────────────────────────
# Lưu ý: Các biến bắt đầu bằng VITE_* sẽ được nhúng vào client JavaScript bundle.
# TUYỆT ĐỐI KHÔNG lưu trữ API Secret Keys, Private Keys hoặc Mật khẩu trong biến VITE_*.

# URL cơ sở của Backend API mà Frontend gọi đến
# - Dev cục bộ (Vite dev proxy): /api hoặc http://localhost:5000/api
# - Docker / Production: https://api.atelierverite.vn/api hoặc /api
# Bắt buộc: Không (Mặc định là '/api')
VITE_API_URL=/api

# Mã Client ID cho đăng nhập Google OAuth 2.0 phía trình duyệt
# Lấy từ Google Cloud Console (APIs & Services > Credentials > Web Client)
# Bắt buộc: Tùy chọn (để trống nếu không dùng Google Login)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Môi trường thực thi của Frontend (development, staging, production)
# Bắt buộc: Không (Mặc định là 'development')
VITE_APP_ENV=development

# Tên thương hiệu hiển thị trên thanh tiêu đề và thông báo
VITE_APP_NAME="ATELIER VÉRITÉ"

# ── [BACKEND] SERVER & RUNTIME ─────────────────────────────────────────────────
# Môi trường chạy Node.js
NODE_ENV=development
APP_ENV=local

# Cổng lắng nghe của máy chủ Express Backend
PORT=5000

# URL công khai của Backend API
BASE_URL=http://localhost:5000

# URL ứng dụng Frontend (cho phép CORS và điều hướng Redirect)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── [DATABASE] MONGODB PERSISTENCE ─────────────────────────────────────────────
# Chuỗi kết nối MongoDB cục bộ (hoặc container trong docker-compose: mongodb://mongo:27017/atelier_fashion)
# Bắt buộc: Có
MONGO_CONNECTIONSTRING=mongodb://127.0.0.1:27017/webfashion_dev

# ── [CACHE & QUEUE] REDIS / BULLMQ ─────────────────────────────────────────────
# Kết nối Redis dùng cho Rate Limiting, Caching, Session và BullMQ Background Jobs
# Bắt buộc: Có
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── [SECURITY] JWT TOKENS & SECRETS ───────────────────────────────────────────
# Khóa bí mật ký phát JWT Bearer Token (Tối thiểu 32 ký tự ngẫu nhiên)
# Tạo khóa ngẫu nhiên an toàn: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bắt buộc: Có
ACCESS_TOKEN_SECRET=dev_insecure_access_token_secret_minimum_32_characters_abc123
REFRESH_TOKEN_SECRET=dev_insecure_refresh_token_secret_minimum_32_characters_abc123
ACTION_SECRET=dev_insecure_action_secret_minimum_32_characters_abc123
OTP_SECRET=dev_insecure_otp_secret_minimum_32_characters_abc123

# ── [NOTIFICATION] EMAIL & OTP SERVICE (NODEMAILER) ───────────────────────────
# Tài khoản SMTP gửi mã xác thực OTP đăng nhập và cập nhật trạng thái đơn hàng
# Bắt buộc: Tùy chọn cho local dev
EMAIL_USER=dev_test_mailer@example.com
EMAIL_PASS=your_dummy_app_password

# ── [AI ENGINE] OPENROUTER / OPENAI INTEGRATION ───────────────────────────────
# API Key cấp quyền trợ lý tư vấn phong cách AI
# Bắt buộc: Tùy chọn (Backend tự chuyển sang fallback nếu không có key)
OPENROUTER_API_KEY=sk-or-v1-dummy_openrouter_dev_api_key_placeholder

# ── [SHIPPING] GIAO HÀNG NHANH (GHN SANDBOX) ──────────────────────────────────
# Thông tin API đối tác vận chuyển GHN môi trường thử nghiệm
GHN_TOKEN=your_ghn_sandbox_token_placeholder
GHN_SHOP_ID=your_ghn_sandbox_shop_id_placeholder
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
DEFAULT_SHIPPING_FEE=30000

# ── [PAYMENT] CỔNG THANH TOÁN MOMO (SANDBOX) ──────────────────────────────────
# Tham số kết nối cổng MoMo Sandbox để test đặt cọc và thanh toán online
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_dev_access_key
MOMO_SECRET_KEY=your_momo_dev_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5000/api/payments/momo/return
MOMO_IPN_URL=https://your-public-webhook-domain.example.com/api/payments/momo/ipn
MOMO_LANG=vi

# ── [PAYMENT] CỔNG THANH TOÁN VNPAY (SANDBOX) ─────────────────────────────────
# Tham số kết nối cổng VNPay Sandbox
VNP_TMNCODE=your_vnpay_dev_tmncode
VNP_HASHSECRET=your_vnpay_dev_hashsecret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:5000/api/payments/vnpay/return
VNP_IPN_URL=https://your-public-webhook-domain.example.com/api/payments/vnpay/ipn
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURRCODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDERTYPE=fashion
