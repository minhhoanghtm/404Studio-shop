# ==============================================================================
# ATELIER VÉRITÉ — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This workspace consists of:
#   - frontend/ (React 19 + TypeScript + Vite)
#   - backend/  (Express.js + MongoDB + Redis)
#
# When running "npm run dev" from the workspace root:
#   - Backend loads backend/.env (port 5000)
#   - Frontend loads frontend/.env and root .env (Vite reads envDir: '..')
# ==============================================================================

# --- APPLICATION ---
APP_ENV=local
NODE_ENV=development

# --- BACKEND CORE CONFIGURATION ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
BACKEND_INTERNAL_PORT=5000
PORT=5000
BASE_URL=http://127.0.0.1:5000
BACKEND_URL=http://127.0.0.1:5000

# --- FRONTEND & REVERSE PROXY ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_INTERNAL_PORT=80
FRONTEND_PREVIEW_PORT=4173
FRONTEND_URL=http://127.0.0.1:5173
CLIENT_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# --- DATABASE & INFRASTRUCTURE ---
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_INTERNAL_PORT=27017
MONGO_DATABASE=webfashion_dev
MONGO_CONNECTIONSTRING=mongodb://127.0.0.1:27017/webfashion_dev
MONGO_RS_HOST=127.0.0.1
MONGO_RS_PORT=27019
MONGO_RS_INTERNAL_PORT=27019
MONGO_RS_NAME=rs0
MONGO_RS_DATABASE=webfashion_dev_rs
MONGO_RS_CONNECTIONSTRING=mongodb://127.0.0.1:27019/webfashion_dev_rs?replicaSet=rs0

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# --- AI SERVICE ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8081
AI_SERVICE_INTERNAL_PORT=8081
NODE_BACKEND_BASE_URL=http://127.0.0.1:5000
SPRING_AI_SERVICE_URL=http://127.0.0.1:8081

# --- TESTING / PLAYWRIGHT ---
PLAYWRIGHT_HOST=127.0.0.1
PLAYWRIGHT_PORT=5173
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
PLAYWRIGHT_CI_HOST=127.0.0.1
PLAYWRIGHT_CI_PORT=4179

# --- SECURITY SECRETS (Replace with cryptographically secure strings >= 32 chars) ---
ACCESS_TOKEN_SECRET=dev_access_token_secret_minimum_32_characters_123456
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_minimum_32_characters_123456
ACTION_SECRET=dev_action_secret_key_minimum_32_characters_123456
OTP_SECRET=dev_otp_secret_key_minimum_32_characters_123456

# --- FRONTEND CLIENT VARIABLES (Exposed to Vite browser client) ---
VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_STRICT_PORT=true
VITE_API_URL=/api
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:5000
VITE_WS_URL=http://127.0.0.1:5000
VITE_APP_ENV=development
VITE_APP_NAME="ATELIER VÉRITÉ"
