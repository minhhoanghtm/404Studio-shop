# ATELIER VÉRITÉ — Frontend Environment Configuration
# Copy to frontend/.env (or root .env) for local development. Never commit production secrets.

# Browser REST API Base URL.
# When using Vite proxy, leave as /api.
# When connecting directly across origins without proxy, use http://localhost:5000/api
VITE_API_URL=/api

# Backend server address for Vite proxy and server-side forwarding (default: http://localhost:5000)
VITE_BACKEND_URL=http://localhost:5000

# Optional Google OAuth client ID (public browser configuration, not a secret)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend environment label and application name
VITE_APP_ENV=development
VITE_APP_NAME="ATELIER VÉRITÉ"
