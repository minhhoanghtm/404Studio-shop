# ATELIER VÉRITÉ frontend environment template
# Copy to the workspace-root .env when sharing environment loading with backend,
# or to frontend/.env when running the frontend independently. Never commit real credentials.

# Base URL for browser API calls. Defaults to /api when omitted.
VITE_API_URL=/api

# Optional Google OAuth client ID. This is public browser configuration, not a secret.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional frontend environment label and display name.
VITE_APP_ENV=development
VITE_APP_NAME="ATELIER VÉRITÉ"
