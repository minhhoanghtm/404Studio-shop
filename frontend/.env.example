# ATELIER VÉRITÉ — Frontend Environment Configuration
# Copy to frontend/.env (or root .env) for local development. Never commit production secrets.

# Browser REST API Base URL.
# When using Vite proxy or Nginx reverse proxy, leave as /api.
# When connecting directly across origins without proxy, set full URL e.g. http://127.0.0.1:5000/api
VITE_API_URL=/api
VITE_API_BASE_URL=/api

# Vite Dev & Preview Server Binding (strictPort enabled)
VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_STRICT_PORT=true

# Backend server address for Vite proxy and WebSocket connections
VITE_BACKEND_URL=http://127.0.0.1:5000
VITE_WS_URL=http://127.0.0.1:5000

# Optional Google OAuth client ID (public browser configuration, not a secret)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend environment label and application name
VITE_APP_ENV=development
VITE_APP_NAME="ATELIER VÉRITÉ"
