# ==============================================================================
# REACT-WebFashion — 404 Studio: STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

NODE_ENV=staging
APP_ENV=staging
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
BACKEND_INTERNAL_PORT=5000
PORT=5000
BASE_URL=http://127.0.0.1:5000
BACKEND_URL=http://127.0.0.1:5000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8088
FRONTEND_INTERNAL_PORT=80
CLIENT_URL=http://localhost:8088
FRONTEND_URL=http://localhost:8088
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Isolated Staging Database (Strictly separated from Production)
STAGING_MONGO_USER=<mongo-username>
STAGING_MONGO_PASSWORD=<mongo-password>
MONGO_HOST=mongo-staging
MONGO_PORT=27017
MONGO_INTERNAL_PORT=27017
MONGO_DATABASE=webfashion_staging
MONGO_CONNECTIONSTRING=mongodb://<username>:<password>@mongo-staging:27017/webfashion_staging?authSource=admin
REDIS_URL=redis://redis-staging:6379
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379

# Authentication & Security
JWT_SECRET=<generate-a-unique-secret>
ACCESS_TOKEN_SECRET=<generate-a-unique-secret>
REFRESH_TOKEN_SECRET=<generate-a-unique-secret>
SESSION_SECRET=<generate-a-unique-secret>
ACTION_SECRET=<generate-a-unique-secret>
OTP_SECRET=<generate-a-unique-secret>
STAGING_CUSTOMER_PASSWORD=<test-customer-password>
STAGING_ADMIN_PASSWORD=<test-admin-password>

# Vector AI & Embedding Settings
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_SEARCH_ENGINE=mongo_cosine
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_OR_VAULT_REFERENCE

# A/A & Recommendation Experimentation Framework
ACTIVE_REC_EXPERIMENT_ID=AA_Recommendation_Validation
EXPERIMENT_KILL_SWITCH_ENABLED=false
DEFAULT_REC_ALGORITHM=control_popular
EXPERIMENT_ATTRIBUTION_WINDOW_HOURS=24
EXPERIMENT_STICKY_CACHE_TTL_DAYS=30

# Rate Limiting & Queue Tuning
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
TRACKING_BATCH_SIZE=25
TRACKING_QUEUE_CONCURRENCY=5
