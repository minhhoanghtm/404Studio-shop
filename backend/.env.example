# ==============================================================================
# ATELIER VÉRITÉ / THREEUI — Backend Environment Configuration (.env.example)
# Copy to .env in local development and provide appropriate non-secret values.
# DO NOT COMMIT REAL CREDENTIALS, KEYS, OR PRODUCTION PASSWORDS TO GIT.
# ==============================================================================

# ── 1. Application & Server Runtime ──────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── 2. Database Connection (MongoDB) ─────────────────────────────────────────
# Local development MongoDB or MongoDB Atlas Dev Sandbox
MONGO_CONNECTIONSTRING=mongodb://127.0.0.1:27017/webfashion_dev
# Alternative MongoDB connection string alias
MONGO_URI=mongodb://127.0.0.1:27017/webfashion_dev

# ── 3. In-Memory Cache, Sessions & Queue Workers (Redis) ─────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Require Redis adapter for multi-instance socket clustering
SOCKET_REDIS_ADAPTER_REQUIRED=false

# ── 4. JWT & Cryptographic Secrets (Minimum 32 Characters) ───────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=dev_access_token_secret_minimum_32_characters_123456
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_minimum_32_characters_123456
ACTION_SECRET=dev_action_secret_key_minimum_32_characters_123456
OTP_SECRET=dev_otp_secret_key_minimum_32_characters_123456

# ── 5. SMS & OTP Verification Configuration ──────────────────────────────────
# Provider choices: console | esms
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# eSMS Gateway Configuration (Production / Staging)
ESMS_API_KEY=your_esms_api_key
ESMS_SECRET_KEY=your_esms_secret_key
ESMS_BRANDNAME=Baotrixemay
ESMS_ENDPOINT=http://rest.esms.vn/MainService.svc/json
ESMS_SMS_TYPE=2
ESMS_SANDBOX=0

# ── 6. Email Dispatch (Nodemailer) ───────────────────────────────────────────
EMAIL_USER=dev_test_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── 7. OAuth 2.0 Identity Providers ──────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── 8. AI Shopping Assistant & LLM Providers ─────────────────────────────────
# Provider choices: openrouter | openai | deepseek
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_dev_api_key
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key

# AI Chat Rate Limits & Token Budgeting
AI_CHAT_DAILY_QUOTA=50
AI_CHAT_DAILY_TOKEN_BUDGET=50000
AI_CHAT_MAX_TOKENS=1024
AI_CHAT_TIMEOUT_MS=30000
# Spring AI is opt-in. When enabled, Node remains the JWT/RBAC and business-logic owner.
AI_ORCHESTRATOR=node
SPRING_AI_SERVICE_URL=http://localhost:8081
AI_SERVICE_SHARED_SECRET=replace_with_a_long_random_shared_secret
SPRING_AI_TIMEOUT_MS=30000
AI_INPUT_COST_USD_PER_1M=0.15
AI_OUTPUT_COST_USD_PER_1M=0.60

# ── 9. Vector Search & Embedding Engine ──────────────────────────────────────
# Search engines: mongo_cosine | atlas
VECTOR_SEARCH_ENGINE=mongo_cosine
VECTOR_INDEX_NAME=vector_index
VECTOR_MIN_SIMILARITY=0.65

# Embedding models: openai/text-embedding-3-small | text-embedding-004
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY_MS=500
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── 10. Behavioral Tracking, Privacy & Recommendations ───────────────────────
ACTIVE_REC_EXPERIMENT_ID=AA_Recommendation_Validation
TRACKING_HALF_LIFE_DAYS=30
USER_EVENTS_TTL_DAYS=90

# ── 11. Shipping Partner (GHN - Giao Hàng Nhanh Sandbox) ─────────────────────
GHN_TOKEN=your_ghn_sandbox_token
GHN_SHOP_ID=your_ghn_sandbox_shop_id
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
DEFAULT_SHIPPING_FEE=30000

# ── 12. MoMo Payment Gateway (Sandbox Environment) ───────────────────────────
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_dev_access_key
MOMO_SECRET_KEY=your_momo_dev_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5000/api/payments/momo/return
MOMO_IPN_URL=https://your-public-ngrok-or-dev-domain.ngrok-free.dev/api/payments/momo/ipn
MOMO_LANG=vi

# ── 13. VNPay Payment Gateway (Sandbox Environment) ──────────────────────────
VNP_TMNCODE=your_vnpay_dev_tmncode
VNP_HASHSECRET=your_vnpay_dev_hashsecret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:5000/api/payments/vnpay/return
VNP_IPN_URL=https://your-public-ngrok-or-dev-domain.ngrok-free.dev/api/payments/vnpay/ipn
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURRCODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDERTYPE=fashion

# ── 14. Order Policies & Timing ──────────────────────────────────────────────
ONLINE_PAYMENT_TTL_MINUTES=15
ALLOW_VOUCHER_ON_SALE=false

# ── 15. Testing & Diagnostic Flags ───────────────────────────────────────────
DISABLE_RATE_LIMIT_FOR_TESTS=false

# ── 16. Multi-Provider AI & Image Generation Integration ─────────────────────
# AI Core Orchestration
AI_DEFAULT_PROVIDER=auto
AI_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT_MS=60000

# Google Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash-001
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional Image Providers (FLUX, Stable Diffusion, OpenRouter)
FLUX_API_KEY=
FLUX_IMAGE_MODEL=black-forest-labs/flux-1-schnell

# Smart AI Task-Based Routing
AI_IMAGE_DEFAULT_PROVIDER=auto
AI_MARKETING_DEFAULT_PROVIDER=auto
AI_ANALYTICS_DEFAULT_PROVIDER=auto

# Image Generation & Cost Limits
AI_IMAGE_DAILY_LIMIT=20
AI_IMAGE_MAX_VARIANTS=4
AI_MONTHLY_BUDGET_USD=10

# Free-first image generation. A zero budget blocks all paid image requests.
AI_IMAGE_ROUTING_MODE=FREE_FIRST
AI_IMAGE_ALLOW_PAID_FALLBACK=false
AI_IMAGE_ALLOW_METERED_FREE_TIER=false
AI_IMAGE_DAILY_BUDGET_USD=0
AI_IMAGE_MONTHLY_BUDGET_USD=0

# Cloudflare Workers AI (backend only; FLUX.1 Schnell is metered in Neurons)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Pollinations (backend only; inspect the live catalog/account before enabling)
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell

# Local ComfyUI (no model download is performed by this application)
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=

