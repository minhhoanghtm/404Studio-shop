{
  "name": "back-end",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node src/scripts/unit-test-runner.mjs",
    "test:qa:jest": "node --env-file=.env.qa --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:qa:node": "node --env-file=.env.qa src/scripts/qa-node-test-runner.mjs",
    "lint": "eslint src",
    "dev": "nodemon src/server.js",
    "start": "node  src/server.js",
    "worker": "node src/worker.js",
    "seed:pages": "node seed/pages.js",
    "seed:demo": "node seed/seed-demo-catalog.js",
    "ai:sync": "node src/scripts/sync-vectors.js",
    "ai:reindex": "node src/scripts/sync-vectors.js",
    "ai:audit:staging": "node src/scripts/audit-ai-real-staging.mjs",
    "k6:all": "powershell -ExecutionPolicy Bypass -File load-tests/run-all.ps1",
    "k6:run": "powershell -ExecutionPolicy Bypass -Command \"$n=$env:TEST; k6 run load-tests/$n.js; $t=Get-Date -Format 'yyyy-MM-dd_HH-mm'; Copy-Item load-tests/results/TEMPLATE.md load-tests/results/${n}_${t}.md; Write-Host 'Report: load-tests/results/${n}_${t}.md'\"",
    "wait": "node src/scripts/wait-on-health.mjs",
    "seed:complete": "node src/scripts/seed-complete-dev-data.js",
    "seed:qa": "node src/scripts/seed-qa-fixtures.js",
    "migrate:drop-legacy-sessions": "node src/scripts/drop-legacy-sessions-collection.js",
    "migrate:product-slugs": "node src/migrations/ensureProductSlugs.js",
    "migrate:variant-skus": "node src/migrations/migrateVariantSkus.js",
    "test:e2e": "node --env-file=.env.qa src/scripts/qa-node-test-runner.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.0",
    "color": "^5.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "k6": "^0.0.0",
    "moment": "^2.30.1",
    "mongoose": "^9.3.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "qs": "^6.15.2",
    "remove-accents": "^0.5.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.8",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.64.1",
    "supertest": "^7.2.2",
    "wait-on": "^9.0.10"
  }
}
