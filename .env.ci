# ==============================================================================
# ATELIER VÉRITÉ — NON-SECRET CI NETWORK & RUNTIME CONFIGURATION (.env.ci)
# Used by GitHub Actions workflows and isolated CI Compose checks.
# Ephemeral cryptographic secrets are generated at runtime in CI.
# ==============================================================================

APP_ENV=ci
NODE_ENV=test

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
BACKEND_INTERNAL_PORT=5000
PORT=5000
BASE_URL=http://127.0.0.1:5000
BACKEND_URL=http://127.0.0.1:5000

# Frontend & Reverse Proxy
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_INTERNAL_PORT=80
FRONTEND_PREVIEW_PORT=4173
FRONTEND_URL=http://127.0.0.1:5173
CLIENT_URL=http://127.0.0.1:5173
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Frontend Vite / Client API & WebSocket
VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_STRICT_PORT=true
VITE_API_URL=/api
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:5000
VITE_WS_URL=http://127.0.0.1:5000
VITE_APP_ENV=ci
VITE_APP_NAME="ATELIER VÉRITÉ"

# CORS
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4179

# MongoDB (Standalone + Replica Set for Atomicity CI Job)
MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_INTERNAL_PORT=27017
MONGO_DATABASE=atelier_verite_qa
MONGO_CONNECTIONSTRING=mongodb://127.0.0.1:27018/atelier_verite_qa

MONGO_RS_HOST=127.0.0.1
MONGO_RS_PORT=27019
MONGO_RS_INTERNAL_PORT=27019
MONGO_RS_NAME=rs0
MONGO_RS_DATABASE=atelier_verite_qa_rs
MONGO_RS_CONNECTIONSTRING=mongodb://127.0.0.1:27019/atelier_verite_qa_rs?replicaSet=rs0
QA_RS_MONGO_URI=mongodb://127.0.0.1:27019/atelier_verite_qa_rs?replicaSet=rs0

# Redis (Unit suite + Atomicity CI Job)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

QA_REDIS_HOST=127.0.0.1
QA_REDIS_PORT=6381
QA_REDIS_URL=redis://127.0.0.1:6381

# AI Service & Providers
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8081
AI_SERVICE_INTERNAL_PORT=8081
NODE_BACKEND_BASE_URL=http://backend:5000
SPRING_AI_SERVICE_URL=http://127.0.0.1:8081

# QA / Atomicity Target Alignment in CI
QA_API_URL=http://127.0.0.1:5000/api
QA_FRONTEND_URL=http://127.0.0.1:5173

# Playwright Testing
PLAYWRIGHT_HOST=127.0.0.1
PLAYWRIGHT_PORT=5173
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4179
PLAYWRIGHT_CI_HOST=127.0.0.1
PLAYWRIGHT_CI_PORT=4179
